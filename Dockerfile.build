# Enso Builder Dockerfile
# 用于构建 Enso IDE 的完整开发环境
# 用法: docker build -t enso-builder -f Dockerfile.build .

FROM ghcr.io/graalvm/jdk-community:25.0.1 AS base

# 安装基础工具
USER root
RUN apt-get update && apt-get install -y \
    curl \
    git \
    tar \
    gzip \
    unzip \
    build-essential \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 安装 Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# 安装 Node.js 和 pnpm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g corepack && \
    corepack enable && \
    corepack prepare pnpm@10.2.1 --activate

# 安装 Bazelisk（自动下载正确版本的 Bazel）
RUN curl -Lo /usr/local/bin/bazel https://github.com/bazelbuild/bazelisk/releases/latest/download/bazelisk-linux-amd64 && \
    chmod +x /usr/local/bin/bazel

# 创建工作目录
WORKDIR /enso

# 复制项目文件
COPY . /enso/

# 设置环境变量
ENV JAVA_HOME=/opt/java
ENV PATH="${JAVA_HOME}/bin:/root/.cargo/bin:/usr/local/bin:${PATH}"
ENVO ENSO_LAUNCHER=native

# 构建项目
RUN echo "正在安装依赖..." && \
    corepack pnpm install && \
    echo "正在构建..." && \
    ./run backend get && \
    echo "构建完成！"

# 默认命令
CMD ["/bin/bash"]
